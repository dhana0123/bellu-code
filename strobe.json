{
  "build": { "command": "bun run build", "cwd": "packages/app", "output": "packages/app/dist" },
  "serve": { "command": "bun e2e/utils/serve.ts --host 127.0.0.1 --port {port}", "cwd": "packages/app" },
  "apps": {
    "bellucode": {
      "exe": {
        "windows": "%LOCALAPPDATA%/Programs/ai.bellucode.desktop/BelluCode.exe",
        "macos": "/Applications/BelluCode.app/Contents/MacOS/BelluCode"
      },
      "unset": ["BELLUCODE_*", "OTEL_*", "SENTRY_*"],
      "env": {
        "BELLUCODE_DB": "{home}/.local/share/bellucode/bellucode.db",
        "BELLUCODE_CONFIG_DIR": "{home}/.config/bellucode",
        "HTTP_PROXY": "http://127.0.0.1:9",
        "HTTPS_PROXY": "http://127.0.0.1:9",
        "NO_PROXY": "localhost,127.0.0.1,::1"
      },
      "dirs": [".local/share/bellucode"],
      "files": {
        ".config/bellucode/service.json": { "port": "{port}" },
        "AppData/Local/@bellucodedesktop-updater": "a file, not a folder: the updater cannot stage a download while strobe measures"
      },
      "guard": [{ "file": "~/.local/state/bellucode/service.json", "pid": "pid", "url": "url" }],
      "protocols": ["bellucode"]
    },
    "bellucode-beta": {
      "extends": "bellucode",
      "exe": {
        "windows": "%LOCALAPPDATA%/Programs/ai.bellucode.desktop.beta/BelluCode Beta.exe",
        "macos": "/Applications/BelluCode Beta.app/Contents/MacOS/BelluCode Beta"
      }
    }
  }
}

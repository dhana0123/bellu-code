      "severity": "high",
      "category": "network_exposure",
      "applies_to": [
        "azure_resource"
      ],
      "remediation": "Restrict the source or use Azure Bastion.",
      "benchmarks": [
        "CIS-Azure-2.0:6.1"
      ],
      "rego": "nsg_rdp_open.rego"
    }

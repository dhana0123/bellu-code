# Hardened systemd unit for bellugraph-server.
#
# Setup:
#   useradd --system --no-create-home --shell /usr/sbin/nologin bellu-graph
#   install -d -o bellu-graph -g bellu-graph /etc/bellu-graph
#   cp examples/bellugraph-server.yaml /etc/bellu-graph/bellugraph-server.yaml   # set data_dir: /var/lib/bellu-graph
#   # secrets (bearer tokens) go in an env file, root-readable only:
#   printf 'BELLU_GRAPH_AUTH_TOKENS=%s\n' "$(openssl rand -hex 32)" > /etc/bellu-graph/bellu-graph.env
#   chmod 600 /etc/bellu-graph/bellu-graph.env
#   cp deploy/bellugraph-server.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now bellugraph-server

[Unit]
Description=BelluGraph - the living map of your infrastructure
Documentation=https://bellu-graph.dev
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bellu-graph
Group=bellu-graph
ExecStart=/usr/local/bin/bellugraph-server --config /etc/bellu-graph/bellugraph-server.yaml
# Bearer tokens and other secrets come from the environment, never the command line.
EnvironmentFile=-/etc/bellu-graph/bellu-graph.env
Restart=on-failure
RestartSec=5s

# Persistent state lives in /var/lib/bellu-graph (set data_dir to it in the config).
StateDirectory=bellu-graph
StateDirectoryMode=0750

# --- sandboxing ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
